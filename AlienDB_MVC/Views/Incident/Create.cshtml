@model AlienDB_MVC.Models.Incident

@{
    ViewData["Title"] = "Skapa Incident";
}

<!-- Rubrik -->
<h1>Skapa Incident</h1>

<br />

<!-- Formulär -->
<form asp-action="Create" method="post">

    <!-- Namn -->
    <div class="mb-3">

        <label class="form-label">
            Namn
        </label>

        <input asp-for="Namn"
               class="form-control" />

    </div>

    <!-- Plats -->
    <div class="mb-3">

        <label class="form-label">
            Plats
        </label>

        <input asp-for="Plats"
               class="form-control"
               list="platsLista" />

        <datalist id="platsLista">

            <option value="Tokyo"></option>

            <option value="New York"></option>

            <option value="Area 51"></option>

            <option value="Göteborg"></option>

            <option value="Stockholm"></option>

            <option value="Oslo"></option>

            <option value="Köpenhamn"></option>

        </datalist>

    </div>

    <!-- Region -->
    <div class="mb-3">

        <label class="form-label">
            Region
        </label>

        <select asp-for="Region"
                class="form-select">

            <option value="Sverige">Sverige</option>
            <option value="Norge">Norge</option>
            <option value="Finland">Finland</option>
            <option value="Danmark">Danmark</option>
            <option value="Norden">Norden</option>
            <option value="Europa">Europa</option>
            <option value="Nordamerika">Nordamerika</option>
            <option value="Asien">Asien</option>
            <option value="Afrika">Afrika</option>
            <option value="Okänd">Okänd</option>

        </select>

    </div>

    <!-- Knapp -->
    <button type="submit"
            class="btn btn-success">

        Skapa Incident

    </button>

    <a asp-action="Index"
           class="btn btn-secondary">

        Tillbaka

    </a>

</form>