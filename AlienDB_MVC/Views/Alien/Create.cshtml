@model AlienDB_MVC.Models.Alien

@{
    // Sidtitel
    ViewData["Title"] = "Create Alien";
}

<!-- Rubrik -->
<h1 class="mb-4">👽 Create Alien</h1>

<!-- Formulär för att skapa alien -->
<form asp-action="Create" method="post">

    <!-- Alien-namn -->
    <div class="mb-3">
        <label class="form-label">Namn</label>

        <input asp-for="Namn"
               class="form-control" />
    </div>

    <!-- Dropdown för alien-ras -->
    <div class="mb-3">

        <label asp-for="RasID" class="form-label">
            Ras
        </label>

        <select asp-for="RasID"
                asp-items="ViewBag.Raser"
                class="form-select">

            <option value="">
                -- Välj ras --
            </option>

        </select>

    </div>

  
    <!-- Antal armar -->
    <div class="mb-3">
        <label class="form-label">Antal armar</label>

        <input asp-for="AntalArmar"
               class="form-control" />
    </div>

    <!-- Dropdown för favoritvapen -->
    <div class="mb-3">

        <label asp-for="FavoritVapen" class="form-label">
            Favoritvapen
        </label>

        <select asp-for="FavoritVapen"
                class="form-select">

            <option value="">
                -- Välj vapen --
            </option>

            <option value="Laserpistol">
                Laserpistol
            </option>

            <option value="Tankesändare">
                Tankesändare
            </option>

            <option value="Plasmagevär">
                Plasmagevär
            </option>

            <option value="Ingen">
                Ingen
            </option>

        </select>

    </div>

    <!-- Dropdown för farlighetsgrad -->
    <div class="mb-3">

        <label asp-for="Farlighetsgrad" class="form-label">
            Farlighetsgrad
        </label>

        <select asp-for="Farlighetsgrad"
                class="form-select">

            <option value="">
                -- Välj farlighetsgrad --
            </option>

            <option value="Ofarlig">Ofarlig</option>
            <option value="Farlig">Farlig</option>
            <option value="Extrem">Extrem</option>

        </select>

    </div>

    <!-- Skapa-knapp -->
    <button type="submit"
            class="btn btn-success">
        Skapa Alien
    </button>

    <a asp-action="Index"
           class="btn btn-secondary">

        Tillbaka

    </a>

</form>